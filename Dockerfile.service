# Builds the upload-service: plain HTTP/JSON, no ffmpeg needed.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/upload-service ./cmd/upload-service

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/upload-service /usr/local/bin/upload-service
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/upload-service"]
